{
  "manifest_version": 3,
  "name": "Language translation Connector",
  "version": "1.1",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "popup-style.css"
      ]
    }
  ]
}